// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Staff {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // ハッシュ化して保存
  name      String
  role      String   @default("admin") // 将来の権限分け用
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id                String    @id @default(uuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  name              String
  furigana          String
  gender            String
  dob               DateTime
  postalCode        String
  address           String
  phone             String
  email             String?   @unique // お客様ログイン用

  emergencyPhone    String
  emergencyName     String
  emergencyRelation String
  
  plan              String?   @default("未設定")
  status            String    @default("入会済み")

  // 手動回数管理用
  manualTotalSessions Int?
  usedSessionsAdjustment Int? @default(0)
  planStartDate     DateTime?

  complaint         String?
  idealState        String?
  desiredServices   String?

  metrics           Metric[]
  goals             Goal[]
  sessions          Session[]
  reports           Report[]
  customerLogs      CustomerLog[]
}

model CustomerLog {
  id          String   @id @default(uuid())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  type        String   // Meal, Workout, Diary
  title       String?  // 内容の短い見出し
  content     String?  // 詳細テキスト
  imageUrl    String?  // 食事写真などのURL
  weight      Float?   // 日記用
  bodyFat     Float?   // 日記用
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Metric {
  id                  String   @id @default(uuid())
  createdAt           DateTime @default(now())
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId          String
  date                DateTime @default(now())

  // セッション計測スコア
  weight              Float?
  bloodPressureHigh   Int?     // 上の血圧
  bloodPressureLow    Int?     // 下の血圧

  // 月1回身体計測
  waist               Float?
  belly               Float?
  armL                Float?
  armR                Float?
  thighL              Float?
  thighR              Float?
  calfL               Float?
  calfR               Float?

  // 健康診断フィードバック
  bloodTestFeedback   String?
}

model Goal {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId       String

  longTermPurpose  String   // 達成したい目的
  actionPlan       String?  // 具体的なアクション・今月の目標
  targetWeight     Float?   // 目標体重
  deadline         DateTime? // 達成期限
  month            String   // 管理用（月の区切りなど）
}

model Session {
  id                 String   @id @default(uuid())
  createdAt          DateTime @default(now())
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId         String
  date               DateTime @default(now())
  
  duration           Int      @default(60) // 60分 / 90分
  type               String   @default("通常") // 通常 / 体験

  // コンディション
  conditionSelf      String?
  conditionObjective String?

  // トレーニング内容（旧テキスト、互換性のために残す）
  routinesText       String?  @map("routines")
  homework           String?
  conversation       String?

  // 構造化されたメニュー
  menuItems          SessionMenu[]
  photos             SessionPhoto[]

  // AI分析
  aiSummary          String?
  aiAdvice           String?
  postureAnalysis    String?
  clientMotivation   String?

  // スタッフ用非公開メモ
  smallTalk         String?  // 日常生活・雑談など（お客様には非表示）
  fullTranscript    String?  // 文字起こし全文
}

model SessionMenu {
  id        String   @id @default(uuid())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  name      String   // 種目名
  type      String   // トレーニング / ストレッチ
  sets      Int?     // セット数
  reps      String?  // 回数（例: "10,10,12"）
  weight    String?  // 重さ（例: "20kg"）
  note      String?  // 備考
}

model SessionPhoto {
  id        String   @id @default(uuid())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  url       String   // 画像URL
  viewType  String   // Front, Side, Other
  timing    String   // Before, After
  aiAnalysis String? // AIによる姿勢分析結果
  createdAt DateTime @default(now())
}

model Report {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  title         String
  content       String   // AI生成レポート内容
  type          String   // Session / Monthly
  periodStart   DateTime?
  periodEnd     DateTime?
}

model VideoGuide {
  id          String   @id @default(uuid())
  title       String
  url         String   // YouTube link
  description String?
  category    String   // トレーニング, ストレッチなど
  createdAt   DateTime @default(now())
}
